{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "Security": {
    "ApiKey": "__SECURITY_API_KEY__"
  },
  "JWT": {
    "Key": "__JWT_KEY__",
    "Issuer": "bo.auth.api"
  },
  "Context": {
    "Auth": "__MSSQL_CONNECTION_STRING__"
  },
  "AllowedHosts": "*",
  "Telemetry": {
    "Environment": "dev",
    "Enabled": "false"
  }
}
